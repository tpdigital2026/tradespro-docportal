# Copy to .env.local. Never commit real values.
CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BANK_ENCRYPTION_KEY=
LOGIN_PEPPER=
SESSION_SECRET=
# 32+ random characters. Vercel Cron sends it as a bearer token to /api/cron/maintenance (daily purge and storage
# sweep); the route answers 401 without it.
CRON_SECRET=
ANTHROPIC_API_KEY=
# Optional. With ANTHROPIC_API_KEY set, "Generate copy" on the scope step asks the model to tidy the wording.
# Without it the basic tidy is used. ANTHROPIC_MODEL names the model (defaults to claude-sonnet-5-5).
ANTHROPIC_MODEL=
